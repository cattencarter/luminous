<llsd>
    <map>
        <!-- <Lumen> Agni and Aditi, and nothing else.

             OpenSim grids are the user's own: added in Preferences >
             OpenSim (or typed into the login screen's grid row), they are
             kept in user_settings/grids.user.xml. No grid list is downloaded
             (GridListDownload is off and GridListDownloadURL empty).

             Neither grid names a loginpage: the viewer shows its own local
             start page. The nicks, login ids, SLURL bases and web profiles
             are Linden Lab's own (llviewernetwork.cpp), so a Second Life
             session keeps its grid ids ("Agni", "Aditi"), its WebRTC voice
             STUN servers (named from grid_login_id) and links; LastModified
             is newer than any copy in grids.user.xml, so these values win. -->
        <key>util.aditi.lindenlab.com</key>
        <map>
        <key>LastModified</key>
            <date>2026-11-08T12:00:00Z</date>
        <key>app_slurl_base</key>
            <string>secondlife:///app</string>
        <key>grid_login_id</key>
            <string>Aditi</string>
        <key>gridname</key>
            <string>Second Life Beta</string>
        <key>gridnick</key>
            <string>Aditi</string>
        <key>helperuri</key>
            <string>https://secondlife.aditi.lindenlab.com/helpers/</string>
        <key>login_identifier_types</key>
            <array>
                <string>agent</string>
            </array>
        <key>loginpage</key>
            <undef />
        <key>loginuri</key>
            <array>
                <string>https://login.aditi.lindenlab.com/cgi-bin/login.cgi</string>
            </array>
            <key>name</key>
            <string>util.aditi.lindenlab.com</string>
            <key>slurl_base</key>
            <string>secondlife://Aditi/secondlife/</string>
            <key>system_grid</key>
            <integer>1</integer>
            <key>web_profile_url</key>
            <string>https://my.secondlife-beta.com/</string>
        </map>
        <key>util.agni.lindenlab.com</key>
        <map>
            <key>LastModified</key>
            <date>2026-11-08T12:00:00Z</date>
            <key>app_slurl_base</key>
            <string>secondlife:///app</string>
            <key>favorite</key>
            <integer>1</integer>
            <key>grid_login_id</key>
            <string>Agni</string>
            <key>gridname</key>
            <string>Second Life</string>
            <key>gridnick</key>
            <string>Agni</string>
        <key>helperuri</key>
        <string>https://secondlife.com/helpers/</string>
        <key>login_identifier_types</key>
        <array>
            <string>agent</string>
        </array>
        <key>loginpage</key>
        <undef />
        <key>loginuri</key>
        <array>
            <string>https://login.agni.lindenlab.com/cgi-bin/login.cgi</string>
        </array>
        <key>name</key>
        <string>util.agni.lindenlab.com</string>
        <key>slurl_base</key>
        <string>https://maps.secondlife.com/secondlife/</string>
        <key>system_grid</key>
        <integer>1</integer>
        <key>web_profile_url</key>
        <string>https://my.secondlife.com/</string>
        </map>
    </map>
</llsd>
